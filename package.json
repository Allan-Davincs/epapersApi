{
  "name": "epapers-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "worker": "node --conditions=react-server --import tsx worker/index.ts",
    "test": "vitest run",
    "test:db": "node --env-file=.env scripts/test-db.mjs",
    "openapi": "node --env-file=.env --conditions=react-server --import tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@prisma/client": "^6.14.0",
    "argon2": "^0.41.1",
    "jose": "^6.0.12",
    "next": "^15.4.6",
    "nodemailer": "^10.1.0",
    "pino": "^9.9.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.4.6",
    "prisma": "^6.14.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  },
  "prisma": {
    "seed": "node --conditions=react-server --import tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "^8.5.29"
  }
}
