# Application
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
COOKIE_DOMAIN=localhost

# CockroachDB connection string (use sslmode=verify-full in production)
DATABASE_URL=postgresql://username:password@localhost:26257/epapers?sslmode=disable

# Cloudflare R2. Use separate private buckets for incoming and published PDFs.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_INCOMING_BUCKET=epapers-incoming
R2_PUBLISHED_BUCKET=epapers-published
R2_PUBLIC_BASE_URL=

# Generate independent random values with at least 32 bytes of entropy.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
IP_HASH_SALT=replace-with-at-least-32-random-bytes

# Email: smtp or resend. SMTP is configured for Google SMTP by default.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=replace-with-google-app-password
SMTP_FROM="Epapers <your-account@gmail.com>"
RESEND_API_KEY=

# Optional operational settings
MAX_UPLOAD_BYTES=15728640
DAILY_UPLOAD_QUOTA=20
SIGNED_URL_TTL_SECONDS=600
LOG_LEVEL=info

# base64-encoded 32 random bytes; separate from JWT and refresh pepper
DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
EMAIL_FROM="Epapers <your-account@gmail.com>"
SMTP_DAILY_LIMIT=450
# A disposable CockroachDB database; never point this at production
TEST_DATABASE_URL=
